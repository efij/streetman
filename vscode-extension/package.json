{
  "name": "streetman-lean",
  "displayName": "Streetman Lean",
  "version": "1.0.1",
  "publisher": "streetman",
  "description": "Streetman Lean plus all-lanes token, code transport, and security proof gates.",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": ["Other"],
  "activationEvents": [
    "onCommand:streetmanLean.instructions",
    "onCommand:streetmanLean.review",
    "onCommand:streetmanLean.gate",
    "onCommand:streetmanLean.prove"
  ],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "streetmanLean.instructions",
        "title": "Streetman Lean: Show Instructions"
      },
      {
        "command": "streetmanLean.review",
        "title": "Streetman Lean: Review Diff"
      },
      {
        "command": "streetmanLean.gate",
        "title": "Streetman Lean: Gate Diff"
      },
      {
        "command": "streetmanLean.prove",
        "title": "Streetman Lean: Prove Diff"
      }
    ]
  }
}
